---
import projetosData from "@/data/projetos.json";
import type { ImageMetadata } from "astro";
import ProjectsSection, { type ProjectItem } from "./components/ProjectsSection";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projetos/*.{jpeg,jpg,png,gif,webp,svg}",
  { eager: true }
);

const projetos: ProjectItem[] = projetosData.map((project) => {
  const fullPath = project.image.startsWith("/")
    ? project.image
    : `/src/assets/projetos/${project.image}`;

  const image = imageModules[fullPath];
  if (!image) {
    throw new Error(
      `Imagem "${project.image}" não encontrada em "/src/assets/projetos/". Verifique o arquivo JSON.`
    );
  }

  return {
    ...project,
    alignment: (project.alignment as "left" | "right") || undefined,
    imageSrc: image.default.src,
  };
});
---

<section id="projetos" class="min-h-screen px-4 py-12 sm:px-8 sm:py-16 overflow-hidden">
    <div class="flex flex-col px-2 sm:px-0 lg:ml-[4.27%]">
        <p class="z-20 text-[clamp(0.75rem,0.73vw,0.875rem)] font-semibold tracking-[0.08em] uppercase text-neutral font-space-mono">
            03/
        </p>
        
        <div class="flex flex-row gap-3 sm:gap-4 items-center">
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[clamp(2.25rem,3.75vw,4.5rem)] leading-[1.2] font-bold tracking-[-0.03em] whitespace-nowrap font-fraunces text-white">
                Projetos
            </h2>
            <span class="bg-white flex-1 h-[2px] sm:h-1 my-auto mr-4 sm:mr-8"></span>
        </div>
    </div>

    <ProjectsSection client:load projects={projetos} />
</section>