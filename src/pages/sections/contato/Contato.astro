    </div>

    <script>
        import "@/components/ui/textReveal.js";
        import ScrollTrigger from "gsap/ScrollTrigger";

        const contactSection = document.getElementById("contato");
        const animatedElements = contactSection?.querySelectorAll<HTMLElement>("[data-animate-on-scroll]");

        function triggerAnimation() {
            if (!animatedElements?.length) return;
            animatedElements.forEach((el) => {
                const animClass = el.getAttribute("data-animate-on-scroll");
                if (animClass) {
                    el.classList.remove("opacity-0");
                    el.classList.add(...animClass.split(" "));
                }
            });
        }

        if (contactSection && animatedElements?.length) {
            const prevSection = contactSection.previousElementSibling;
            
            // Como a seção de contato usa reveal parallax (sticky), usamos ScrollTrigger para sincronizar com a revelação
            if (prevSection) {
                ScrollTrigger.create({
                    trigger: prevSection,
                    start: "bottom 60%",
                    once: true,
                    onEnter: () => triggerAnimation(),
                });
            }

            // Fallback com IntersectionObserver
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting && entry.intersectionRatio > 0.1) {
                            triggerAnimation();
                            observer.disconnect();
                        }
                    });
                },
                { threshold: [0.1, 0.25] }
            );

            observer.observe(contactSection);
        }
    </script>

</footer>
