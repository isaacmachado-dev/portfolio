---
import { GraduationCap } from "lucide-react";
import type { ComponentType } from "react";

interface Props {
    title: string;
    subtitle?: string;
    period: string;
    icon?: ComponentType<{ className?: string }>;
}

const { title, subtitle, period, icon: Icon = GraduationCap } = Astro.props;
---

<div class="timeline-item group relative flex flex-row items-center gap-3 sm:gap-5 w-full py-2.5 sm:py-3">
    <div class="relative flex items-center justify-center shrink-0 w-6 self-stretch">
        <div class="timeline-line-top [[data-autoscroll=true]_&]:!block group-first:hidden absolute -top-4 bottom-1/2 w-0.5 bg-white left-1/2 -translate-x-1/2 pointer-events-none"></div>
        <div class="timeline-line-bottom [[data-autoscroll=true]_&]:!block group-last:hidden absolute top-1/2 -bottom-4 w-0.5 bg-white left-1/2 -translate-x-1/2 pointer-events-none"></div>
        <div class="relative z-10 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-white shrink-0"></div>
    </div>

    <div class="bg-white p-4 sm:p-5 rounded-md flex-1 min-w-0 max-w-lg text-ink shadow-sm flex flex-col justify-between">
        <div class="flex flex-col min-w-0">
            <div class="flex flex-row gap-2.5 items-center min-w-0">
                <slot name="icon">
                    <Icon className="w-5 h-5 sm:w-6 sm:h-6 shrink-0" />
                </slot>
                <span class="font-space-grotesk font-bold text-base sm:text-lg leading-snug">
                    {title}
                </span>
            </div>
            {subtitle && (
                <div class="ml-7 sm:ml-8 mt-1 text-xs sm:text-sm font-space-mono text-neutral-700">
                    {subtitle}
                </div>
            )}
        </div>

        <div class="period-bottom flex @[680px]:hidden mt-3 pt-2 border-t border-neutral-200/80 items-center justify-between text-xs font-space-mono">
            <span class="font-bold text-neutral-800">{period}</span>
        </div>
    </div>

    <div class="period-side hidden @[680px]:flex items-center justify-end text-white font-space-mono text-sm whitespace-nowrap shrink-0 w-24 text-right pr-2">
        {period}
    </div>
</div>
