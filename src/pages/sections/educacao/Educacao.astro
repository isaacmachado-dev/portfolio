---
import GithubContributions from "@/components/GithubContributions";
import InteractiveTerminal from "@/components/ui/terminal";
import { Award } from "lucide-react";
import EducacaoFrame from "./components/EducacaoFrame.astro";
import EducacaoItem from "./components/EducacaoItem.astro";

// Busca inicial em tempo de build/SSR
let contributions = [];
try {
  const response = await fetch(
    "https://github-contributions-api.jogruber.de/v4/isaacmachado-dev?y=last"
  );
  if (response.ok) {
    const json = await response.json();
    contributions = json.contributions || [];
  }
} catch (error) {
  console.error("Erro ao buscar contribuições do GitHub:", error);
}
---

<section id="educacao" class="min-h-screen px-4 py-12 sm:px-8 sm:py-16 overflow-hidden">

    <div class="flex flex-col px-2 sm:px-0 lg:ml-[4.27%]">
        <p class="z-20 text-[clamp(0.75rem,0.73vw,0.875rem)] font-semibold tracking-[0.08em] uppercase text-neutral font-space-mono">
            02/
        </p>
        
        <div class="flex flex-row gap-3 sm:gap-4 items-center">
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[clamp(2.25rem,3.75vw,4.5rem)] leading-[1.2] font-bold tracking-[-0.03em] whitespace-nowrap font-fraunces text-white">
                Fundamentos
            </h2>
            <span class="bg-white flex-1 h-[2px] sm:h-1 my-auto mr-4 sm:mr-8"></span>
        </div>
    </div>

    <div class="flex flex-col gap-8 w-full max-w-[1720px] mx-auto px-1 sm:px-4 md:px-8 mt-8 sm:mt-10">
        <!-- Linha 1: Conquistas acadêmicas e Terminal lado a lado com a mesma altura garantida -->
        <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-stretch w-full lg:h-[375px]">
            <div class="w-full lg:w-1/2 flex flex-col h-[260px] sm:h-[300px] lg:h-full min-h-0">
                <EducacaoFrame title="Educação">
                    <EducacaoItem
                        title="Ensino Superior"
                        subtitle="UNIVESP — Engenharia da Computação"
                        period="2023-2028"
                    />

                    <EducacaoItem
                        title="Alura React"
                        period="2026"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="IBM IA & Machine learning"
                        period="2025"
                        icon={Award}
                    />
                    <EducacaoItem
                        title="QP Summit 2025"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Alura Cloud DEV-Ops"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Alura DEV Games"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Postman API Fundamentals Student Expert"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Amazon AWS Educate Introduction to Generative AI"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Imersão DEV Back-End"
                        period="2025"
                        icon={Award}
                    />

                    <EducacaoItem
                        title="Ensino Médio"
                        period="2020-2022"
                    />

                    <EducacaoItem
                        title="Ensino Fundamental"
                        period="2010-2019"
                    />

                </EducacaoFrame>
            </div>

            <div class="w-full lg:w-1/2 flex flex-col h-[260px] sm:h-[300px] lg:h-full min-h-0">
                <EducacaoFrame title="Terminal" showLine={false}>
                    <InteractiveTerminal 
                        client:load 
                        className="h-full w-full" 
                        title="isaac@arch"
                        inputPlaceholder="Escreva o comando.." 
                    />
                </EducacaoFrame>
            </div>
        </div>

        <!-- Linha 2: Contribuições e Café lado a lado (desktop) e empilhados (zoom / telas menores) -->
        <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-stretch w-full">
            <!-- Card Contribuições -->
            <div class="w-full lg:flex-1 flex flex-col min-h-0">
                <EducacaoFrame showLine={false} title="Contribuições GIT-Hub" class="h-full">
                    <div class="flex justify-start sm:justify-center items-center w-full h-full overflow-x-auto py-2 custom-scrollbar">
                        <GithubContributions
                            client:visible
                            initialData={contributions}
                            username="isaacmachado-dev"
                        />
                    </div>
                </EducacaoFrame>
            </div>

            <!-- Card Café -->
            <div class="w-full lg:w-[320px] xl:w-[380px] flex flex-col min-h-0">
                <EducacaoFrame showLine={false} title="Café" class="h-full">
                    <div class="flex items-center justify-center h-full py-6 min-h-[160px]">
                        <object type="image/svg+xml" data="/coffee-animated.svg" class="w-28 h-28 pointer-events-none mx-auto"></object>
                    </div>
                </EducacaoFrame>
            </div>
        </div>
    </div>

</section>